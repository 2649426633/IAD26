<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>_180Detection</RootNamespace>
    <AssemblyName>180Detection</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="camera\HikCameraService.cs" />
    <Compile Include="model\AppSettings.cs" />
    <Compile Include="model\DetectionResult.cs" />
    <Compile Include="model\ProductConfig.cs" />
    <Compile Include="service\AppSettingsService.cs" />
    <Compile Include="service\OnnxInferenceService.cs" />
    <Compile Include="service\ProductConfigService.cs" />
    <Compile Include="style\UiTheme.cs" />

    <Compile Include="page\Index.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="page\Index.Designer.cs">
      <DependentUpon>Index.cs</DependentUpon>
    </Compile>
    <Compile Include="page\SmoothZoomPictureBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="page\ZoomViewportPanel.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Include="page\TabDetection.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="page\TabDetection.Designer.cs">
      <DependentUpon>TabDetection.cs</DependentUpon>
    </Compile>
    <Compile Include="page\TabRecords.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="page\TabProductConfig.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Include="page\TabSystemSettings.cs">
      <SubType>UserControl</SubType>
    </Compile>

    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="page\Index.resx">
      <DependentUpon>Index.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="page\TabDetection.resx">
      <DependentUpon>TabDetection.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="runtime\IndustrialAnomaly.Runtime\IndustrialAnomaly.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config\appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
