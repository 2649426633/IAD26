<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Python 推理 -->
    <add key="PythonExecutable" value="python" />
    <add key="InferenceScript" value="" />
    <add key="InferenceWorkingDirectory" value="" />
    <add key="InferenceResultDirectory" value="runtime\results" />
    <add key="InferenceTimeoutSeconds" value="120" />
    <add key="InferenceArgumentsTemplate"
         value="&quot;{script}&quot; --image &quot;{image}&quot; --product &quot;{product}&quot; --output &quot;{output}&quot;" />

    <!-- 海康机器人相机 -->
    <add key="HikCameraSdkAssembly" value="" />
    <add key="CameraExpectedModel" value="MV-CS200-10GM" />

    <!-- 产品、记录与保存 -->
    <add key="ProductConfigPath" value="runtime\config\products.json" />
    <add key="LogDirectory" value="runtime\logs" />
    <add key="SaveOriginalImage" value="true" />
    <add key="SaveMarkedImage" value="true" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
